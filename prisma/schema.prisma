generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    DateTime?
  username         String?          @unique
  firstName        String?
  lastName         String?
  avatar           String?
  phone            String?
  phoneVerified    Boolean          @default(false)
  lonitude         Float?
  latitude         Float?
  role             UserRole         @default(CUSTOMER)
  defaultPincode   String?
  defaultCity      String?
  defaultState     String?
  defaultLatitude  Float?
  defaultLongitude Float?
  defaultRadius    Int?             @default(5000)
  isActive         Boolean          @default(true)
  isBanned         Boolean          @default(false)
  bannedReason     String?
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  bookings         Booking[]
  businessClaims   BusinessClaim[]
  ownedBusinesses  Business[]
  complaints       Complaint[]
  orders           Order[]
  photos           Photo[]
  reportsReceived  Report[]         @relation("ReportsReceived")
  reportsMade      Report[]         @relation("ReportsMade")
  reviewResponses  ReviewResponse[]
  reviewVotes      ReviewVote[]
  reviews          Review[]
  savedBusinesses  SavedBusiness[]
  notifications    Notification[]
  viewedBusinesses BusinessView[]

  @@index([email])
  @@index([username])
  @@index([phone])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([defaultPincode])
  @@map("users")
}

model BusinessChain {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  logo           String?
  description    String?
  corporateEmail String?
  corporatePhone String?
  headquarters   String?
  website        String?
  totalBranches  Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  branches       Business[] @relation("ChainBranches")

  @@index([slug])
  @@index([name])
  @@map("business_chains")
}

model Business {
  id                        String                   @id @default(cuid())
  name                      String
  slug                      String                   @unique
  description               String?
  shortDescription          String?                  @db.VarChar(255)
  logo                      String?
  logoPublicId              String?
  coverImage                String?
  coverImagePublicId        String?
  introVideoUrl             String?
  chainId                   String?
  branchName                String?
  email                     String?
  phone                     String
  alternatePhone            String?
  whatsappNumber            String?
  website                   String?
  addressLine1              String
  addressLine2              String?
  landmark                  String?
  area                      String?
  city                      String
  district                  String?
  state                     String
  pincode                   String
  latitude                  Float
  longitude                 Float
  status                    BusinessStatus           @default(UNCLAIMED)
  businessDocuments         String[]
  priceRange                PriceRange?
  isVerified                Boolean                  @default(false)
  verifiedAt                DateTime?
  acceptsOrders             Boolean                  @default(false)
  acceptsBookings           Boolean                  @default(false)
  hasDelivery               Boolean                  @default(false)
  hasPickup                 Boolean                  @default(false)
  hasDineIn                 Boolean                  @default(false)
  deliveryRadius            Int?
  minOrderAmount            Float?
  deliveryFee               Float?
  minAdvanceBookingHours    Int?                     @default(2)
  maxAdvanceBookingDays     Int?                     @default(30)
  cancellationPolicy        String?
  cancellationDeadlineHours Int?                     @default(24)
  refundPolicy              String?
  autoConfirmBookings       Boolean                  @default(false)
  autoConfirmOrders         Boolean                  @default(false)
  isTemporarilyClosed       Boolean                  @default(false)
  temporaryClosureReason    String?
  temporaryClosureStart     DateTime?
  temporaryClosureEnd       DateTime?
  is24x7                    Boolean                  @default(false)
  hasEmergencyService       Boolean                  @default(false)
  emergencyContactNumber    String?
  emergencyExtraCharge      Float?
  averageRating             Float?                   @default(0)
  totalReviews              Int                      @default(0)
  totalOrders               Int                      @default(0)
  totalBookings             Int                      @default(0)
  totalPhotos               Int                      @default(0)
  totalComplaints           Int                      @default(0)
  viewCount                 Int                      @default(0)
  metaTitle                 String?
  metaDescription           String?
  metadataKeywords          String[]
  ownerId                   String?
  gstNumber                 String?                  @unique
  panNumber                 String?
  offersProducts            Boolean                  @default(false)
  offersServices            Boolean                  @default(false)
  offersDineIn              Boolean                  @default(false)
  offersDelivery            Boolean                  @default(false)
  offersPickup              Boolean                  @default(false)
  offersOnline              Boolean                  @default(false)
  offersOnSite              Boolean                  @default(false)
  serviceRadiusKm           Float?
  acceptsCash               Boolean                  @default(true)
  acceptsUPI                Boolean                  @default(false)
  acceptsCards              Boolean                  @default(false)
  acceptsNetBanking         Boolean                  @default(false)
  acceptsWallets            Boolean                  @default(false)
  requiresAdvancePayment    Boolean                  @default(false)
  advancePaymentPercent     Int?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  deletedAt                 DateTime?
  lastClaimedAt             DateTime?
  search_vector             Unsupported("tsvector")?
  documents                 BusinessDocument[]
  bookings                  Booking[]
  amenities                 BusinessAmenity[]
  categories                BusinessCategory[]
  claims                    BusinessClaim[]
  hours                     BusinessHours[]
  images                    BusinessImage[]
  serviceArea               BusinessServiceArea[]
  staff                     BusinessStaff[]
  chain                     BusinessChain?           @relation("ChainBranches", fields: [chainId], references: [id])
  owner                     User?                    @relation(fields: [ownerId], references: [id])
  complaints                Complaint[]
  menuItems                 MenuItem[]
  orders                    Order[]
  photos                    Photo[]
  promotedListings          PromotedListing[]
  reports                   Report[]
  reviews                   Review[]
  savedBy                   SavedBusiness[]
  serviceAreas              ServiceArea[]
  views                     BusinessView[]

  @@index([slug])
  @@index([status])
  @@index([pincode])
  @@index([city, state])
  @@index([state])
  @@index([latitude, longitude])
  @@index([averageRating])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([gstNumber])
  @@index([chainId])
  @@index([city, status, averageRating])
  @@index([pincode, status])
  @@index([state, city, status])
  @@index([is24x7])
  @@index([hasEmergencyService])
  @@index([description(ops: raw("gin_trgm_ops"))], map: "idx_business_description_trgm", type: Gin)
  @@index([metadataKeywords], map: "idx_business_metadata_keywords_gin", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_business_name_trgm", type: Gin)
  @@index([search_vector], map: "idx_businesses_search_vector", type: Gin)
  @@map("businesses")
}

model BusinessDocument {
  id            String         @id @default(cuid())
  businessId    String
  type          DocumentType
  customName    String?
  fileUrl       String
  publicId      String
  fileType      String
  status        DocumentStatus @default(PENDING)
  rejectionNote String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model ServiceArea {
  id            String   @id @default(cuid())
  businessId    String
  areaName      String?
  pincode       String?
  city          String?
  deliveryFee   Float?   @default(0)
  minimumOrder  Float?
  estimatedTime String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([pincode])
  @@index([isActive])
  @@map("service_areas")
}

model BusinessImage {
  id           String    @id @default(cuid())
  businessId   String
  imageUrl     String
  publicId     String
  thumbnailUrl String?
  caption      String?
  altText      String?
  displayOrder Int       @default(0)
  isFeatured   Boolean   @default(false)
  isApproved   Boolean   @default(true)
  isFlagged    Boolean   @default(false)
  flagReason   String?
  width        Int?
  height       Int?
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([displayOrder])
  @@index([isFeatured])
  @@index([isApproved])
  @@index([deletedAt])
  @@index([businessId, displayOrder])
  @@index([businessId, isFeatured])
  @@map("business_images")
}

model BusinessServiceArea {
  id          String   @id @default(cuid())
  businessId  String
  pincode     String?
  areaName    String?
  city        String?
  state       String?
  radiusKm    Int?
  extraCharge Float?   @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([pincode])
  @@index([city])
  @@index([areaName])
  @@index([isActive])
  @@map("business_service_areas")
}

model BusinessStaff {
  id                    String              @id @default(cuid())
  businessId            String
  name                  String
  designation           String?
  specialization        String?
  photo                 String?
  bio                   String?
  phone                 String?
  email                 String?
  yearsOfExperience     Int?
  qualifications        String?
  averageRating         Float?              @default(0)
  totalBookings         Int                 @default(0)
  isActive              Boolean             @default(true)
  isAvailableForBooking Boolean             @default(true)
  displayOrder          Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  bookings              Booking[]
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingHours          StaffWorkingHours[]

  @@index([businessId])
  @@index([isActive])
  @@index([displayOrder])
  @@index([isAvailableForBooking])
  @@index([deletedAt])
  @@map("business_staff")
}

model StaffWorkingHours {
  id             String        @id @default(cuid())
  staffId        String
  dayOfWeek      DayOfWeek
  startTime      String
  endTime        String
  slotDuration   Int           @default(30)
  breakStartTime String?
  breakEndTime   String?
  isAvailable    Boolean       @default(true)
  specificDate   DateTime?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  staff          BusinessStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek, specificDate])
  @@index([staffId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@index([isAvailable])
  @@map("staff_working_hours")
}

model BusinessHours {
  id              String    @id @default(cuid())
  businessId      String
  dayOfWeek       DayOfWeek
  openTime        String
  closeTime       String
  isClosed        Boolean   @default(false)
  isOverride      Boolean   @default(false)
  overrideDate    DateTime?
  overrideNote    String?
  hasSplitShift   Boolean   @default(false)
  splitCloseTime  String?
  splitReopenTime String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek, overrideDate])
  @@index([businessId])
  @@index([dayOfWeek])
  @@index([overrideDate])
  @@index([isClosed])
  @@map("business_hours")
}

model Category {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  description     String?
  icon            String?
  parentId        String?
  displayOrder    Int?
  isActive        Boolean            @default(true)
  isFeatured      Boolean            @default(false)
  metaTitle       String?
  metaDescription String?
  searchKeywords  String[]
  coverImage      String?
  totalBusinesses Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  businesses      BusinessCategory[]
  parent          Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]         @relation("CategoryHierarchy")

  @@index([slug])
  @@index([parentId])
  @@index([isActive, displayOrder])
  @@index([isFeatured])
  @@index([isActive, isFeatured])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_category_name_trgm", type: Gin)
  @@index([searchKeywords], map: "idx_category_search_keywords_gin", type: Gin)
  @@map("categories")
}

model BusinessCategory {
  businessId   String
  categoryId   String
  isPrimary    Boolean  @default(false)
  displayOrder Int?     @default(0)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
  @@index([businessId])
  @@index([isPrimary])
  @@index([categoryId, isPrimary])
  @@index([categoryId, businessId, isPrimary], map: "idx_business_category_primary")
  @@map("business_categories")
}

model MenuItem {
  id                   String        @id @default(cuid())
  businessId           String
  name                 String
  description          String?
  price                Float
  discountedPrice      Float?
  image                String?
  images               String[]
  category             String?
  subcategory          String?
  isVegetarian         Boolean       @default(false)
  isVegan              Boolean       @default(false)
  isGlutenFree         Boolean       @default(false)
  isJain               Boolean       @default(false)
  spiceLevel           String?
  duration             Int?
  requiresStaff        Boolean       @default(false)
  isAvailable          Boolean       @default(true)
  availableFrom        String?
  availableTo          String?
  hasLimitedStock      Boolean       @default(false)
  stockQuantity        Int?
  tags                 String[]
  displayOrder         Int?
  isFeatured           Boolean       @default(false)
  isBestseller         Boolean       @default(false)
  calories             Int?
  servingSize          String?
  customizationOptions String?
  totalOrders          Int           @default(0)
  averageRating        Float?        @default(0)
  itemType             ServiceType?  @default(PRODUCT)
  deliveryType         DeliveryType? @default(PHYSICAL)
  pricingType          PricingType   @default(FIXED)
  hourlyRate           Float?
  dailyRate            Float?
  priceNote            String?
  serviceDuration      Int?
  requiresBooking      Boolean       @default(false)
  bufferTime           Int?
  availableDays        String[]
  availableOnline      Boolean       @default(false)
  availableAtLocation  Boolean       @default(true)
  availableOnSite      Boolean       @default(false)
  maxTravelDistance    Float?
  skillLevel           String?
  certification        String?
  cancellationPolicy   String?
  slug                 String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]

  @@index([businessId, itemType, pricingType])
  @@index([isAvailable])
  @@index([itemType])
  @@index([pricingType])
  @@index([isVegetarian])
  @@index([isFeatured])
  @@index([isBestseller])
  @@index([category])
  @@index([deletedAt])
  @@index([requiresBooking])
  @@index([businessId, isAvailable])
  @@index([businessId, category])
  @@map("menu_items")
}

model Amenity {
  id           String            @id @default(cuid())
  name         String            @unique
  slug         String            @unique
  icon         String?
  description  String?
  category     String?
  displayOrder Int?
  isActive     Boolean           @default(true)
  isPopular    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  businesses   BusinessAmenity[]

  @@index([slug])
  @@index([isActive])
  @@index([isPopular])
  @@index([category])
  @@map("amenities")
}

model BusinessAmenity {
  businessId String
  amenityId  String
  note       String?
  createdAt  DateTime @default(now())
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, amenityId])
  @@index([amenityId])
  @@index([businessId])
  @@map("business_amenities")
}

model Booking {
  id                 String         @id @default(cuid())
  bookingNumber      String         @unique
  businessId         String
  userId             String
  staffId            String?
  bookingDate        DateTime
  bookingTime        String
  endTime            String?
  duration           Int?
  numberOfPeople     Int?
  status             BookingStatus  @default(PENDING)
  customerName       String
  customerPhone      String
  customerEmail      String?
  serviceIds         String[]
  totalAmount        Float?
  advancePaid        Float?
  specialRequests    String?
  businessNotes      String?
  tableNumber        String?
  roomNumber         String?
  confirmedAt        DateTime?
  confirmedBy        String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?
  refundAmount       Float?
  refundStatus       String?
  markedNoShowAt     DateTime?
  noShowFee          Float?
  reminderSent       Boolean        @default(false)
  reminderSentAt     DateTime?
  reviewId           String?
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  transactionId      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff              BusinessStaff? @relation(fields: [staffId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, bookingDate])
  @@index([userId])
  @@index([staffId])
  @@index([bookingNumber])
  @@index([status])
  @@index([bookingDate])
  @@index([createdAt])
  @@index([businessId, status])
  @@index([businessId, bookingDate, status])
  @@index([userId, status])
  @@index([staffId, bookingDate])
  @@map("bookings")
}

model Order {
  id                    String         @id @default(cuid())
  orderNumber           String         @unique
  businessId            String
  userId                String
  orderType             OrderType
  status                OrderStatus    @default(PENDING)
  deliveryAddress       String?
  deliveryPincode       String?
  deliveryLatitude      Float?
  deliveryLongitude     Float?
  deliveryInstructions  String?
  landmark              String?
  pickupTime            DateTime?
  tableNumber           String?
  customerName          String
  customerPhone         String
  customerEmail         String?
  alternatePhone        String?
  subtotal              Float
  deliveryFee           Float          @default(0)
  packagingFee          Float          @default(0)
  tax                   Float          @default(0)
  taxPercentage         Float?
  discount              Float          @default(0)
  tipAmount             Float          @default(0)
  total                 Float
  couponCode            String?
  couponDiscount        Float?         @default(0)
  paymentStatus         PaymentStatus  @default(PENDING)
  paymentMethod         PaymentMethod?
  transactionId         String?
  paidAt                DateTime?
  estimatedPrepTime     Int?
  estimatedDeliveryTime DateTime?
  acceptedAt            DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  deliveryPartnerId     String?
  deliveryPartnerName   String?
  deliveryPersonName    String?
  deliveryPersonPhone   String?
  trackingUrl           String?
  specialInstructions   String?
  businessNotes         String?
  cancelledAt           DateTime?
  cancellationReason    String?
  cancelledBy           String?
  refundAmount          Float?
  refundedAt            DateTime?
  refundTransactionId   String?
  reviewId              String?
  rating                Int?
  invoiceNumber         String?        @unique
  invoiceUrl            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  items                 OrderItem[]
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderType])
  @@index([createdAt])
  @@index([businessId, status])
  @@index([userId, status])
  @@index([deliveryPincode])
  @@index([businessId, orderType, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  menuItemId      String
  itemName        String
  itemDescription String?
  quantity        Int
  price           Float
  subtotal        Float
  customizations  String?
  specialNotes    String?
  discount        Float    @default(0)
  finalPrice      Float
  taxAmount       Float?   @default(0)
  isReady         Boolean  @default(false)
  isPacked        Boolean  @default(false)
  createdAt       DateTime @default(now())
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// prisma/schema.prisma

// Find and REPLACE the Review model with this:
// Find the enums section (near the bottom) and ADD this new enum:

enum ReviewVerificationStatus {
  UNVERIFIED
  PHOTO_VERIFIED
  MANUALLY_VERIFIED
}


model Review {
  id                 String                    @id @default(cuid())
  businessId         String
  userId             String
  rating             Int
  title              String?                   @db.VarChar(255)
  content            String?
  status             ReviewStatus              @default(PENDING)
  verificationStatus ReviewVerificationStatus  @default(UNVERIFIED)
  visitDate          DateTime?
  visitType          String?
  orderId            String?
  bookingId          String?
  foodRating         Int?
  serviceRating      Int?
  ambienceRating     Int?
  valueRating        Int?
  isVerifiedPurchase Boolean                   @default(false)
  helpfulCount       Int                       @default(0)
  notHelpfulCount    Int                       @default(0)
  totalVotes         Int                       @default(0)
  flaggedReason      String?
  moderatedBy        String?
  moderatedAt        DateTime?
  isPublished        Boolean                   @default(true)
  publishedAt        DateTime?                 @default(now())
  editableUntil      DateTime?
  lastEditedAt       DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  photos             Photo[]
  reports            Report[]
  response           ReviewResponse?
  votes              ReviewVote[]
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, verificationStatus])
  @@index([businessId, helpfulCount])
  @@index([userId])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([businessId, rating])
  @@index([isVerifiedPurchase])
  @@index([isPublished])
  @@index([editableUntil])
  @@map("reviews")
}



model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@index([isHelpful])
  @@map("review_votes")
}

// prisma/schema.prisma
// Find and REPLACE the ReviewResponse model

model ReviewResponse {
  id        String    @id @default(cuid())
  reviewId  String    @unique
  userId    String
  content   String    @db.VarChar(2000)
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  editableUntil DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
  @@index([editableUntil])
  @@map("review_responses")
}


model Complaint {
  id                   String            @id @default(cuid())
  complaintNumber      String            @unique
  businessId           String
  userId               String
  subject              String
  description          String
  category             String
  status               ComplaintStatus   @default(SUBMITTED)
  priority             ComplaintPriority @default(MEDIUM)
  orderId              String?
  bookingId            String?
  attachments          String[]
  contactName          String
  contactPhone         String
  contactEmail         String?
  assignedToId         String?
  assignedAt           DateTime?
  responseFromBusiness String?
  respondedAt          DateTime?
  adminNotes           String?
  resolution           String?
  resolutionType       String?
  compensationAmount   Float?
  compensationStatus   String?
  escalatedAt          DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  requiresFollowUp     Boolean           @default(false)
  followUpDate         DateTime?
  followUpNotes        String?
  satisfactionRating   Int?
  feedbackOnResolution String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([complaintNumber])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([businessId, status])
  @@index([userId, status])
  @@index([status, priority])
  @@map("complaints")
}

model Photo {
  id           String    @id @default(cuid())
  url          String
  thumbnailUrl String?
  caption      String?
  type         MediaType @default(IMAGE)
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  businessId   String?
  reviewId     String?
  userId       String
  isApproved   Boolean   @default(false)
  isFlagged    Boolean   @default(false)
  flagReason   String?
  moderatedBy  String?
  moderatedAt  DateTime?
  viewCount    Int       @default(0)
  likeCount    Int       @default(0)
  isFeatured   Boolean   @default(false)
  displayOrder Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review       Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([reviewId])
  @@index([userId])
  @@index([isApproved])
  @@index([type])
  @@index([isFlagged])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([businessId, isApproved, type])
  @@map("photos")
}

model SavedBusiness {
  id              String    @id @default(cuid())
  userId          String
  businessId      String
  collectionName  String?   @default("Saved")
  collectionColor String?
  note            String?
  reminderDate    DateTime?
  reminderSent    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([collectionName])
  @@index([userId, collectionName])
  @@map("saved_businesses")
}

model BusinessClaim {
  id                        String              @id @default(cuid())
  claimNumber               String              @unique
  businessId                String
  userId                    String
  status                    BusinessClaimStatus @default(PENDING)
  claimantName              String
  claimantDesignation       String?
  claimantPhone             String
  claimantEmail             String?
  documents                 String[]
  documentTypes             String[]
  gstNumber                 String?
  panNumber                 String?
  relationshipToBusiness    String?
  notes                     String?
  reviewedBy                String?
  reviewedAt                DateTime?
  reviewNotes               String?
  rejectionReason           String?
  verificationCallScheduled DateTime?
  verificationCallCompleted Boolean             @default(false)
  verificationCallNotes     String?
  approvedAt                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  business                  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([claimNumber])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedBy])
  @@index([businessId, status])
  @@map("business_claims")
}

model Report {
  id               String    @id @default(cuid())
  reportNumber     String    @unique
  businessId       String?
  reviewId         String?
  reportedUserId   String?
  reporterId       String
  reason           String
  category         String?
  description      String?
  screenshots      String[]
  status           String    @default("PENDING")
  assignedToId     String?
  assignedAt       DateTime?
  priority         String    @default("MEDIUM")
  resolvedBy       String?
  resolvedAt       DateTime?
  resolution       String?
  actionTaken      String?
  requiresFollowUp Boolean   @default(false)
  followUpNotes    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  business         Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reportedUser     User?     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter         User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  review           Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([reviewId])
  @@index([reportedUserId])
  @@index([reporterId])
  @@index([reportNumber])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([status, priority])
  @@map("reports")
}

model PromotedListing {
  id                          String      @id @default(cuid())
  campaignNumber              String      @unique
  businessId                  String
  campaignName                String
  adStatus                    AdStatus    @default(DRAFT)
  placement                   AdPlacement
  targetPincodes              String[]
  targetCities                String[]
  targetStates                String[]
  targetRadius                Int?
  targetCategories            String[]
  targetKeywords              String[]
  dailyBudget                 Float?
  totalBudget                 Float
  costPerClick                Float?
  costPerImpression           Float?
  billingModel                String      @default("CPC")
  startDate                   DateTime
  endDate                     DateTime
  activeHoursStart            String?
  activeHoursEnd              String?
  activeDays                  DayOfWeek[]
  impressions                 Int         @default(0)
  clicks                      Int         @default(0)
  conversions                 Int         @default(0)
  totalSpent                  Float       @default(0)
  ctr                         Float?      @default(0)
  conversionRate              Float?      @default(0)
  costPerConversion           Float?      @default(0)
  adTitle                     String?
  adDescription               String?
  adImage                     String?
  adBadge                     String?
  callToAction                String?
  priority                    Int         @default(0)
  approvedBy                  String?
  approvedAt                  DateTime?
  rejectionReason             String?
  pausedAt                    DateTime?
  pauseReason                 String?
  autoPauseWhenBudgetReached  Boolean     @default(true)
  autoPauseWhenEndDateReached Boolean     @default(true)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  business                    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([adStatus])
  @@index([placement])
  @@index([startDate, endDate])
  @@index([campaignNumber])
  @@index([targetCities])
  @@index([targetPincodes])
  @@index([adStatus, startDate, endDate])
  @@index([businessId, adStatus])
  @@map("promoted_listings")
}

model SearchQuery {
  id                 String   @id @default(cuid())
  query              String
  queryType          String?  @default("TEXT")
  pincode            String?
  city               String?
  state              String?
  area               String?
  latitude           Float?
  longitude          Float?
  radius             Int?
  categoryFilter     String?
  priceRangeFilter   String?
  ratingFilter       Float?
  amenitiesFilter    String[]
  sortBy             String?
  resultCount        Int      @default(0)
  clickedBusinessIds String[]
  firstClickPosition Int?
  clickedCount       Int      @default(0)
  timeToFirstClick   Int?
  noResultsFound     Boolean  @default(false)
  userId             String?
  sessionId          String?
  ipAddress          String?
  userAgent          String?
  deviceType         String?
  browser            String?
  platform           String?
  referrer           String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  createdAt          DateTime @default(now())

  @@index([query])
  @@index([pincode])
  @@index([city])
  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([categoryFilter])
  @@index([noResultsFound])
  @@index([query, city])
  @@index([createdAt, city])
  @@index([categoryFilter, createdAt(sort: Desc)], map: "idx_search_query_category")
  @@index([query, city, createdAt(sort: Desc)], map: "idx_search_query_term_location")
  @@index([userId, createdAt(sort: Desc)], map: "idx_search_query_user")
  @@map("search_queries")
}

model PopularSearch {
  id             String   @id @default(cuid())
  query          String
  category       String?
  city           String?
  pincode        String?
  searchCount    Int      @default(1)
  clickRate      Float    @default(0)
  conversionRate Float    @default(0)
  isTrending     Boolean  @default(false)
  trendScore     Float    @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([query, city, periodStart, periodEnd])
  @@index([query])
  @@index([city])
  @@index([isTrending])
  @@index([searchCount])
  @@index([lastSearchedAt])
  @@index([category])
  @@map("popular_searches")
}

